{
  "name": "@nexplay/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/make-headers.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
