# Build-time settings (these end up in the public JavaScript, so never put secrets here).

# Leave empty in development: the Vite dev server proxies /api to http://localhost:4000.
# In production, the API's origin, for example https://api.example.com (no trailing slash).
VITE_API_URL=

# Origin that hosts uploaded games (the server's GAMES_ORIGIN). The player refuses any other origin.
VITE_GAMES_ORIGIN=http://localhost:4001
