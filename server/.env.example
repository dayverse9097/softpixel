# Copy to .env for local development. Never commit .env.
# In production, set these in your host's secret manager instead of a file.

NODE_ENV=development
PORT=4000
GAMES_PORT=4001
LOG_LEVEL=info
# Number of reverse proxies in front of the API (0 = none). Set this correctly or client IPs (and rate limits) are wrong.
TRUST_PROXY=0

# Runtime role with least privilege (see prisma/sql/roles.sql)
DATABASE_URL=postgresql://nexplay_app:REPLACE_ME@localhost:5432/nexplay
# Read-only role for public routes, limited by row-level security
DATABASE_URL_PUBLIC=postgresql://nexplay_public:REPLACE_ME@localhost:5432/nexplay
# Owner role: used only by "prisma migrate" and the admin scripts, never by the running server
MIGRATOR_DATABASE_URL=postgresql://nexplay_migrator:REPLACE_ME@localhost:5432/nexplay

# Exact origins, no trailing slash. The games origin must be a different host from the app.
APP_ORIGIN=http://localhost:5173
GAMES_ORIGIN=http://localhost:4001

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
PREVIEW_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Storage: "local" for development only. Production requires "s3" (any S3-compatible private bucket).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Upload limits
MAX_ARCHIVE_MB=200
MAX_UNPACKED_MB=500
MAX_FILE_MB=100
MAX_FILES=2000
MAX_COMPRESSION_RATIO=100
EXTRACT_TIMEOUT_SECONDS=120
MAX_COVER_MB=2
MAX_VERSIONS_PER_GAME=20
MAX_GAME_MB=1024

# Optional malware scanning through a clamd daemon. Leave empty to skip scanning.
CLAMAV_HOST=
CLAMAV_PORT=3310

# "postgres" is required in production so limits are shared across instances.
RATE_LIMIT_STORE=memory
AUDIT_RETENTION_DAYS=180
