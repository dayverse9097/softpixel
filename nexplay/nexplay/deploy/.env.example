# Reference only. On the server, ./init-env.sh creates the real .env with generated secrets. Never commit a real .env.
APP_HOST=play.example.com
API_HOST=api.example.com
GAMES_HOST=nexplay-games.example
ACME_EMAIL=you@example.com

ADMIN_DB_PASSWORD=
APP_DB_PASSWORD=
PUBLIC_DB_PASSWORD=

SESSION_SECRET=
PREVIEW_SECRET=
ENCRYPTION_KEY=

S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=nexplay-games
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Set by deploy.sh
NEXPLAY_IMAGE=
NEXPLAY_TOOLS_IMAGE=

# Optional: malware scanning (also add the clamav service profile)
# COMPOSE_PROFILES=scan
# CLAMAV_HOST=clamav
