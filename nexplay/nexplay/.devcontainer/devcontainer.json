{
  "name": "NEXPLAY",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [5173, 4000, 4001],
  "portsAttributes": {
    "5173": { "label": "Web app", "onAutoForward": "notify" },
    "4000": { "label": "API" },
    "4001": { "label": "Game host" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss", "Prisma.prisma"]
    }
  }
}
