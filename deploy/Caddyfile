# HTTPS front door. Caddy gets and renews certificates automatically (ports 80 and 443 must be reachable).
{
	email {$ACME_EMAIL}
}

# The web app (static files). The security headers come from headers.caddy, which the web build generates
# for your real domains.
{$APP_HOST} {
	root * /srv/web
	encode zstd gzip
	import /etc/caddy/headers.caddy
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

# The API. Game uploads can be up to MAX_ARCHIVE_MB (200 by default).
{$API_HOST} {
	encode zstd gzip
	request_body {
		max_size 250MB
	}
	reverse_proxy api:4000
}

# Uploaded games. This must be a different registrable domain from the app.
{$GAMES_HOST} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy games:4001
}
